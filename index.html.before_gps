<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1565c0">
<link rel="manifest" href="manifest.json">
<title>طقس تلمسان</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(180deg, #1565c0, #64b5f6);
  color: white;
  min-height: 100vh;
}

.container {
  max-width: 520px;
  margin: auto;
  padding: 20px 15px;
}

h1 {
  text-align: center;
  margin: 10px 0 25px;
}

.card {
  background: rgba(255,255,255,0.18);
  border-radius: 22px;
  padding: 20px;
  margin-bottom: 15px;
  text-align: center;
  backdrop-filter: blur(8px);
}

.search-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 12px;
}

.search-box {
  display: flex;
  gap: 8px;
  direction: rtl;
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  border-radius: 12px;
  padding: 12px;
  font-size: 16px;
  outline: none;
}

.search-box button {
  padding: 10px 15px;
  white-space: nowrap;
}

.city {
  font-size: 30px;
  font-weight: bold;
}

.country {
  opacity: 0.9;
  margin-bottom: 10px;
}

.weather-icon {
  font-size: 60px;
  margin: 10px;
}

.temp {
  font-size: 64px;
  font-weight: bold;
}

.description {
  font-size: 20px;
  margin-bottom: 20px;
}

.info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.info-box {
  background: rgba(255,255,255,0.12);
  border-radius: 15px;
  padding: 12px 5px;
  font-size: 14px;
}

.info-value {
  font-size: 18px;
  font-weight: bold;
  margin-top: 5px;
}

.status {
  text-align: center;
  padding: 10px;
  font-size: 14px;
}

.hourly-container {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 8px 0;
}

.hourly-item {
  min-width: 95px;
  background: rgba(255,255,255,0.12);
  border-radius: 14px;
  padding: 10px;
  text-align: center;
  flex-shrink: 0;
}

.hourly-time {
  font-weight: bold;
  margin-bottom: 6px;
}

.hourly-icon {
  font-size: 28px;
  margin: 5px 0;
}

.hourly-temp {
  font-size: 17px;
  font-weight: bold;
}

.hourly-extra {
  font-size: 12px;
  opacity: 0.85;
  margin-top: 5px;
}

.forecast-day {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.12);
  border-radius: 15px;
  padding: 12px 10px;
  margin: 8px 0;
}

.forecast-date {
  font-weight: bold;
  width: 30%;
}

.forecast-icon {
  font-size: 30px;
}

.forecast-temp {
  font-size: 15px;
}

.forecast-max {
  font-weight: bold;
}

.forecast-min {
  opacity: 0.8;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 12px 25px;
  font-size: 16px;
  cursor: pointer;
}
</style>
</head>

<body>

<div class="container">

<h1>🌤️ تطبيق الطقس</h1>

<div class="card search-card">

  <div class="search-title">🌍 البحث عن مدينة أو منطقة</div>

  <div class="search-box">
    <input
      type="text"
      id="city-search"
      placeholder="اكتب اسم المدينة..."
      autocomplete="off"
    >

    <button onclick="searchCity()">🔎 بحث</button>
  </div>

  <div id="search-status" class="status"></div>

</div>

<div class="card">

  <div class="city">تلمسان</div>
  <div class="country">الجزائر</div>

  <div class="weather-icon" id="icon">⏳</div>

  <div class="temp" id="temperature">--°</div>

  <div class="description" id="description">
    جاري تحميل حالة الطقس...
  </div>

  <div class="info">

    <div class="info-box">
      💧 الرطوبة
      <div class="info-value" id="humidity">--%</div>
    </div>

    <div class="info-box">
      🌡️ المحسوسة
      <div class="info-value" id="apparent">--°</div>
    </div>

    <div class="info-box">
      💨 الرياح
      <div class="info-value" id="wind">-- كم/س</div>
    </div>

  </div>

</div>

<div class="card">
  <h2>🌅 معلومات اليوم</h2>

  <div class="info">

    <div class="info-box">
      🌅 الشروق
      <div class="info-value" id="sunrise">--:--</div>
    </div>

    <div class="info-box">
      🌇 الغروب
      <div class="info-value" id="sunset">--:--</div>
    </div>

    <div class="info-box">
      🧭 الضغط الجوي
      <div class="info-value" id="pressure">---- hPa</div>
    </div>

  </div>
</div>

<div class="card">
  <h2>🕒 توقعات كل 3 ساعات</h2>
  <div id="hourly-forecast"></div>
</div>

<div class="card">
  <h2>📅 توقعات 7 أيام</h2>
  <div id="forecast"></div>
</div>

<div class="card">
  <div id="update">جاري تحديث البيانات...</div>
  <br>
  <button onclick="loadWeather()">🔄 تحديث</button>
</div>

<div class="card">
  <h3>طقس تلمسان</h3>
  <p>بيانات جوية مباشرة من Open-Meteo</p>
</div>

</div>

<script>

let latitude = 34.8828;
let longitude = -1.3167;

function weatherDescription(code) {

  const descriptions = {
    0: ["☀️", "سماء صافية"],
    1: ["🌤️", "غالبًا صافٍ"],
    2: ["⛅", "غائم جزئيًا"],
    3: ["☁️", "غائم"],
    45: ["🌫️", "ضباب"],
    48: ["🌫️", "ضباب متجمد"],
    51: ["🌦️", "رذاذ خفيف"],
    53: ["🌦️", "رذاذ متوسط"],
    55: ["🌧️", "رذاذ كثيف"],
    61: ["🌧️", "مطر خفيف"],
    63: ["🌧️", "مطر متوسط"],
    65: ["🌧️", "مطر غزير"],
    71: ["🌨️", "ثلوج خفيفة"],
    73: ["🌨️", "ثلوج متوسطة"],
    75: ["❄️", "ثلوج غزيرة"],
    80: ["🌦️", "زخات مطر"],
    81: ["🌦️", "زخات مطر متوسطة"],
    82: ["⛈️", "زخات مطر غزيرة"],
    95: ["⛈️", "عاصفة رعدية"],
    96: ["⛈️", "عاصفة مع برد"],
    99: ["⛈️", "عاصفة قوية مع برد"]
  };

  return descriptions[code] || ["🌤️", "حالة جوية غير معروفة"];
}

async function searchCity() {
  const input = document.getElementById("city-search");
  const status = document.getElementById("search-status");
  const query = input.value.trim();

  if (!query) {
    status.textContent = "⚠️ اكتب اسم مدينة أولاً";
    return;
  }

  status.textContent = "🔎 جاري البحث...";

  try {
    const response = await fetch(
      "https://geocoding-api.open-meteo.com/v1/search?name=" +
      encodeURIComponent(query) +
      "&count=5&language=ar&format=json"
    );

    const data = await response.json();

    if (!data.results || data.results.length === 0) {
      status.textContent = "❌ لم يتم العثور على المدينة";
      return;
    }

    status.innerHTML = data.results.map((place, index) =>
      "<button onclick=\"selectCity(" + index + ")\">" +
      "📍 " + place.name +
      (place.admin1 ? " - " + place.admin1 : "") +
      (place.country ? " - " + place.country : "") +
      "</button>"
    ).join("<br>");

    window.cityResults = data.results;

  } catch (error) {
    console.error(error);
    status.textContent = "❌ حدث خطأ أثناء البحث";
  }
}

function selectCity(index) {
  const place = window.cityResults[index];

  latitude = place.latitude;
  longitude = place.longitude;

  document.querySelector(".city").textContent = place.name;
  document.querySelector(".country").textContent = place.country || "";

  document.getElementById("search-status").textContent =
    "✅ تم اختيار " + place.name + " — جاري تحديث الطقس...";

  loadWeather();
}

async function loadWeather() {

  document.getElementById("update").textContent =
    "جاري تحديث البيانات...";

  try {

    const url =
      "https://api.open-meteo.com/v1/forecast" +
      "?latitude=" + latitude +
      "&longitude=" + longitude +
      "&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,pressure_msl,weather_code" +
      "&hourly=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,pressure_msl,wind_speed_10m,wind_direction_10m" +
      "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset&forecast_days=7" +
      "&timezone=auto";

    const response = await fetch(url);

    if (!response.ok) {
      throw new Error("API error");
    }

    const data = await response.json();

    const current = data.current;

    const weather = weatherDescription(current.weather_code);

    document.getElementById("icon").textContent =
      weather[0];

    document.getElementById("description").textContent =
      weather[1];

    document.getElementById("temperature").textContent =
      Math.round(current.temperature_2m) + "°C";

    document.getElementById("humidity").textContent =
      current.relative_humidity_2m + "%";

    document.getElementById("apparent").textContent =
      Math.round(current.apparent_temperature) + "°C";

    document.getElementById("wind").textContent =
      Math.round(current.wind_speed_10m) + " كم/س";

    // الضغط الجوي الحالي
    document.getElementById("pressure").textContent =
      Math.round(current.pressure_msl) + " hPa";

    // الشروق والغروب لليوم الحالي
    document.getElementById("sunrise").textContent =
      data.daily.sunrise[0].split("T")[1];

    document.getElementById("sunset").textContent =
      data.daily.sunset[0].split("T")[1];

    document.getElementById("update").textContent =
      "آخر تحديث: " + current.time.replace("T", " ");

    const hourlyForecast = document.getElementById("hourly-forecast");
    hourlyForecast.innerHTML = '<div class="hourly-container"></div>';

    const hourlyContainer =
      hourlyForecast.querySelector(".hourly-container");

    let startIndex =
      data.hourly.time.findIndex(t => t >= current.time);

    if (startIndex < 0) startIndex = 0;

    for (
      let i = startIndex;
      i < Math.min(startIndex + 24, data.hourly.time.length);
      i += 3
    ) {
      const time = data.hourly.time[i].split("T")[1];

      const weatherHour =
        weatherDescription(data.hourly.weather_code[i]);

      hourlyContainer.innerHTML += `
        <div class="hourly-item">
          <div class="hourly-time">${time}</div>

          <div class="hourly-icon">
            ${weatherHour[0]}
          </div>

          <div class="hourly-temp">
            ${Math.round(data.hourly.temperature_2m[i])}°C
          </div>

          <div class="hourly-extra">
            💧 ${data.hourly.relative_humidity_2m[i]}%
          </div>

          <div class="hourly-extra">
            💨 ${Math.round(data.hourly.wind_speed_10m[i])} كم/س
          </div>
        </div>
      `;
    }

    const forecast = document.getElementById("forecast");
    forecast.innerHTML = "";

    for (let i = 0; i < data.daily.time.length; i++) {
      const date = new Date(data.daily.time[i] + "T00:00:00");

      const days = [
        "الأحد", "الاثنين", "الثلاثاء",
        "الأربعاء", "الخميس", "الجمعة", "السبت"
      ];

      const weatherDay =
        weatherDescription(data.daily.weather_code[i]);

      forecast.innerHTML += `
        <div class="forecast-day">
          <div class="forecast-date">
            ${i === 0 ? "اليوم" : days[date.getDay()]}
          </div>

          <div class="forecast-icon">
            ${weatherDay[0]}
          </div>

          <div class="forecast-temp">
            <span class="forecast-max">
              ${Math.round(data.daily.temperature_2m_max[i])}°C
            </span>
            /
            <span class="forecast-min">
              ${Math.round(data.daily.temperature_2m_min[i])}°C
            </span>
          </div>
        </div>
      `;
    }

  } catch (error) {

    document.getElementById("description").textContent =
      "تعذر تحميل بيانات الطقس";

    document.getElementById("update").textContent =
      "تحقق من اتصال الإنترنت";

    console.log(error);
  }
}

loadWeather();

  if ("serviceWorker" in navigator) { navigator.serviceWorker.register("./service-worker.js").catch(console.error); }
</script>

</body>
</html>
